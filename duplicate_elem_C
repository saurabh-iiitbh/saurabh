#include<stdio.h>
int main(){
    int arr[]={2,2,4,9,5};
    int size=5;
    for(int i=0;i<size-1;i++){
        for(int j=i+1;j<size;j++)
        if(arr[i]==arr[j]){
            printf("Duplicate found");
            return 0;}
            
        
       
    }printf("No duplicate");
   return 0;
}
